{
  "name": "mcp-person-roster",
  "version": "0.1.0",
  "description": "MCP server for a person roster: who may DM you, see your space, or joke with you — default deny. 人物名册与权限，默认拒绝。",
  "type": "module",
  "bin": {
    "mcp-person-roster": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "TROUBLESHOOTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "import-friends": "node scripts/import-friends.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roster",
    "allowlist",
    "permissions",
    "ai-agent",
    "qq"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "author": "HOHOLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoholi-668/mcp-roster.git"
  },
  "homepage": "https://github.com/hoholi-668/mcp-roster#readme",
  "bugs": {
    "url": "https://github.com/hoholi-668/mcp-roster/issues"
  },
  "publishConfig": {
    "access": "public"
  }
